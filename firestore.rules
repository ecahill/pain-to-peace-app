// Firestore Security Rules for Pain to Peace Hypnosis App
// Last updated: 2025-01-22

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =============================================================================
    // PUBLIC TRACKS COLLECTION - Read-only for everyone
    // =============================================================================
    // Path: /tracks/{trackId}
    // Purpose: Stores metadata for hypnosis tracks (title, description, etc.)
    match /tracks/{trackId} {
      // Allow anyone to read track information (public content)
      allow read: if true;
      
      // Only authenticated users can create/update tracks
      // In production, you might want to restrict this to admins only
      allow create, update: if request.auth != null
                            && isValidTrackData()
                            && hasRequiredTrackFields();
      
      // Only admins can delete tracks
      allow delete: if isAdmin();
    }
    
    // =============================================================================
    // USER PROFILES - Users manage their own data
    // =============================================================================
    // Path: /users/{userId}
    // Purpose: Stores user profile information, preferences, and statistics
    match /users/{userId} {
      // Users can read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Users can create and update their own profile
      allow create, update: if request.auth != null 
                            && request.auth.uid == userId
                            && isValidUserData()
                            && hasRequiredUserFields();
      
      // Users cannot delete their profile (use Firebase Auth for account deletion)
      allow delete: if false;
    }
    
    // =============================================================================
    // USER PROGRESS TRACKING - Private user data
    // =============================================================================
    // Path: /userProgress/{userId}_{trackId}
    // Purpose: Stores listening progress for each user/track combination
    match /userProgress/{progressId} {
      // Users can read their own progress
      allow read: if request.auth != null 
                  && progressId.matches('^' + request.auth.uid + '_.*');
      
      // Users can create/update their own progress
      allow create, update: if request.auth != null 
                            && progressId.matches('^' + request.auth.uid + '_.*')
                            && isValidProgressData();
      
      // Users can delete their own progress
      allow delete: if request.auth != null 
                    && progressId.matches('^' + request.auth.uid + '_.*');
    }
    
    // =============================================================================
    // USER SESSIONS - Activity tracking
    // =============================================================================
    // Path: /userSessions/{userId}/sessions/{sessionId}
    // Purpose: Stores individual listening sessions for analytics
    match /userSessions/{userId}/sessions/{sessionId} {
      // Users can read their own sessions
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Users can create their own sessions
      allow create: if request.auth != null 
                    && request.auth.uid == userId
                    && isValidSessionData();
      
      // Sessions are immutable once created (for integrity)
      allow update, delete: if false;
    }
    
    // =============================================================================
    // ADMIN COLLECTION - Administrative data
    // =============================================================================
    // Path: /admin/{document}
    // Purpose: App configuration, admin-only data, analytics
    match /admin/{document} {
      // Only admins can access admin documents
      allow read, write: if isAdmin();
    }
    
    // =============================================================================
    // APP SETTINGS - Public configuration
    // =============================================================================
    // Path: /appSettings/{setting}
    // Purpose: Public app configuration that anyone can read
    match /appSettings/{setting} {
      // Anyone can read app settings
      allow read: if true;
      
      // Only admins can modify app settings
      allow write: if isAdmin();
    }
    
    // =============================================================================
    // HELPER FUNCTIONS
    // =============================================================================
    
    // Check if the user is an admin
    function isAdmin() {
      return request.auth != null 
             && request.auth.token.admin == true;
    }
    
    // Validate track data structure
    function isValidTrackData() {
      let data = request.resource.data;
      return data.keys().hasAll(['title', 'description', 'category', 'duration', 'isFree'])
             && data.title is string && data.title.size() > 0 && data.title.size() <= 100
             && data.description is string && data.description.size() <= 500
             && data.category in ['SLEEP', 'PAIN', 'ANXIETY']
             && data.duration is string && data.duration.matches('^[0-9]+ min$')
             && data.isFree is bool
             && (!('audioUrl' in data) || data.audioUrl is string)
             && (!('imageUrl' in data) || data.imageUrl is string);
    }
    
    // Check required track fields
    function hasRequiredTrackFields() {
      let data = request.resource.data;
      return 'createdAt' in data && 'updatedAt' in data;
    }
    
    // Validate user profile data
    function isValidUserData() {
      let data = request.resource.data;
      return (!('email' in data) || data.email is string)
             && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 50))
             && (!('isPremium' in data) || data.isPremium is bool)
             && (!('preferences' in data) || data.preferences is map)
             && (!('stats' in data) || isValidStatsData(data.stats))
             && (!('favorites' in data) || (data.favorites is list && data.favorites.size() <= 1000));
    }
    
    // Check required user fields
    function hasRequiredUserFields() {
      let data = request.resource.data;
      return 'createdAt' in data && 'updatedAt' in data;
    }
    
    // Validate user statistics data
    function isValidStatsData(stats) {
      return stats is map
             && (!('sessionsCompleted' in stats) || stats.sessionsCompleted is int)
             && (!('totalListeningTime' in stats) || stats.totalListeningTime is int)
             && (!('favoriteTracksCount' in stats) || stats.favoriteTracksCount is int)
             && (!('streakDays' in stats) || stats.streakDays is int);
    }
    
    // Validate progress data
    function isValidProgressData() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'trackId', 'progress'])
             && data.userId is string
             && data.trackId is string
             && data.progress is number
             && data.progress >= 0 && data.progress <= 100
             && (!('completed' in data) || data.completed is bool);
    }
    
    // Validate session data
    function isValidSessionData() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'trackId', 'startTime'])
             && data.userId is string
             && data.trackId is string
             && data.startTime is timestamp
             && (!('endTime' in data) || data.endTime is timestamp)
             && (!('duration' in data) || data.duration is int)
             && (!('completed' in data) || data.completed is bool);
    }
    
    // =============================================================================
    // DENY ALL OTHER PATHS - Security by default
    // =============================================================================
    // Explicitly deny access to any paths not defined above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

/*
FIRESTORE SECURITY RULES EXPLANATION:

1. TRACKS COLLECTION (/tracks/{trackId})
   - PUBLIC READ: Anyone can read track metadata
   - AUTHENTICATED WRITE: Only logged-in users can create/update tracks
   - ADMIN DELETE: Only admins can delete tracks
   - Validates data structure and required fields

2. USER PROFILES (/users/{userId})
   - PRIVATE ACCESS: Users can only access their own profile
   - SELF-MANAGED: Users control their own data
   - NO DELETION: Profiles can't be deleted via Firestore (use Auth)
   - Validates user data structure

3. USER PROGRESS (/userProgress/{userId}_{trackId})
   - PRIVATE ACCESS: Users can only see their own progress
   - DOCUMENT ID FORMAT: Must start with user's UID
   - FULL CONTROL: Users can create, read, update, delete their progress
   - Validates progress data (0-100%)

4. USER SESSIONS (/userSessions/{userId}/sessions/{sessionId})
   - PRIVATE ACCESS: Users can only see their own sessions
   - IMMUTABLE: Sessions can't be modified once created (data integrity)
   - ANALYTICS READY: Designed for usage tracking and analytics

5. ADMIN COLLECTION (/admin/{document})
   - ADMIN ONLY: Requires admin custom claim
   - FULL ACCESS: Admins have complete control
   - CONFIGURATION: Stores app settings and admin data

6. APP SETTINGS (/appSettings/{setting})
   - PUBLIC READ: Anyone can read app configuration
   - ADMIN WRITE: Only admins can modify settings
   - GLOBAL CONFIG: App-wide settings and configuration

7. DATA VALIDATION
   - All data is validated for type, size, and structure
   - Required fields are enforced
   - Prevents malformed data and potential exploits

8. SECURITY PRINCIPLES
   - Principle of least privilege
   - User data isolation
   - Data validation at the database level
   - Default deny for undefined paths
*/